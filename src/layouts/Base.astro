---
import { SITE, NAV, AUTHOR } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  /** Large welcome banner (home page); other pages get a slim band. */
  hero?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  hero = false,
} = Astro.props;
const fullTitle = title ? `${title} ${SITE.titleSeparator} ${SITE.title}` : SITE.title;
// Preview deploys live under a sub-path: keep them out of search results and
// point canonical at the production URL so they never compete with it.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const isPreview = base !== '';
const pathname = Astro.url.pathname.slice(base.length) || '/';
const canonical = new URL(pathname, Astro.site).href;
const current = pathname;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content={AUTHOR.name} />
    <link rel="canonical" href={canonical} />
    {(noindex || isPreview) && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {type === 'article' && <meta property="article:author" content={AUTHOR.name} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} Feed`} href="/feed.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {
      SITE.gaId && !isPreview && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`} />
          <script is:inline define:vars={{ gaId: SITE.gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
    <script is:inline>
      // Apply the saved theme before first paint (no flash).
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oxanium:wght@500;600&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class:list={['site-header', { 'site-header-hero': hero }]}>
      <div class="masthead">
        <div class="masthead-inner card">
        <a class="site-title" href="/">{SITE.title}</a>
        <nav aria-label="Main">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.url} aria-current={current.startsWith(item.url) ? 'page' : undefined}>
                    {item.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button class="theme-toggle" type="button" aria-label="다크 모드 전환" title="다크 모드 전환">
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        </button>
        </div>
      </div>
      {
        hero && (
          <div class="hero-content">
            <span class="hero-eyebrow">{SITE.heroEyebrow}</span>
            <p class="hero-title">
              {SITE.title}
              <span class="hero-sparkle" aria-hidden="true">✧</span>
            </p>
            <p class="hero-sub">{AUTHOR.bio}</p>
          </div>
        )
      }
      <svg class="waves" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true">
        <path class="wave wave-1" d="M0 34 Q150 14 300 34 T600 34 T900 34 T1200 34 T1500 34 T1800 34 V60 H0 Z" />
        <path class="wave wave-2" d="M0 40 Q150 22 300 40 T600 40 T900 40 T1200 40 T1500 40 T1800 40 V60 H0 Z" />
        <path class="wave wave-3" d="M0 46 Q150 32 300 46 T600 46 T900 46 T1200 46 T1500 46 T1800 46 V60 H0 Z" />
      </svg>
    </header>
    <div id="main" class="page-wrap">
      <slot />
    </div>
    <footer class="site-footer">
      <ul class="footer-links">
        <li><a href="https://github.com/Isaac-Kwon">GitHub</a></li>
        <li><a href="https://facebook.com/Minjae.Isaac.Kwon">Facebook</a></li>
        <li><a href="/feed.xml">Feed</a></li>
      </ul>
      <p>&copy; {new Date().getFullYear()} {SITE.title}.</p>
    </footer>
    <script>
      const root = document.documentElement;
      const isDark = () =>
        root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
