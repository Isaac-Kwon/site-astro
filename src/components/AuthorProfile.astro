---
import Icon from './Icon.astro';
import { AUTHOR } from '../consts';
---

<aside class="author-profile card" aria-label="Author">
  <img class="author-avatar" src={AUTHOR.avatar} alt={AUTHOR.name} width="240" height="240" />
  <div class="author-text">
    <h3 class="author-name">{AUTHOR.name}</h3>
    <p class="author-bio">{AUTHOR.bio}</p>
  </div>
  <details class="author-links" open>
    <summary>Follow</summary>
    <ul>
      <li class="author-location"><Icon name="pin" size={15} /> {AUTHOR.location}</li>
      {AUTHOR.links.map((l) => <li><a href={l.url} rel="me">{l.label}</a></li>)}
    </ul>
  </details>
</aside>
